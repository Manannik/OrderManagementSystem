{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderProcessingServiceConnectionString": "Host=host.docker.internal;Port=5434;Username=postgres;Password=postgres;Database=OrderProcessingDb",
    "HangfireConnectionString": "Host=host.docker.internal;Port=5434;Username=postgres;Password=postgres;Database=OrderProcessingDb",
    "Seq": "http://localhost"
  },
  "Kafka": {
    "OrderCreated": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "Order-processing-service",
      "Topic": "order-created"
    },
    "Notification": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification",
      "Topic": "notification"
    }
  },  
  "Serilog": {
  "Using": [
    "Serilog.Sinks.Console",
    "Serilog.Sinks.Seq"
  ],
  "MinimumLevel": {
    "Default": "Information",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "WriteTo": [
    {
      "Name": "Console"
    },
    {
      "Name": "Seq",
      "Args": {
        "serverUrl" : "http://serilog_seq:5341"
      }
    }
  ],
  "Enrich": [
    "FromLogContext",
    "WithThreadId",
    "WithMachineName"
  ]
}
}
